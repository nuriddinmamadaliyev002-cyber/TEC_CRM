PORT=3010
HOST=127.0.0.1

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=today_edu
DB_USER=today_edu_user
DB_PASSWORD=

# JWT (kamida 32 belgi):  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=8h

# Superadmin (bitta; adminlarni shu hisob yaratadi). Hash olish:  npm run hash -- "parol"
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_NAME=Today Education Centre
SUPERADMIN_PASSWORD_HASH=''

# Telegram bot (@BotFather). Backendda token FAQAT nomzodlar rezyumesini Telegramdan yuklab olish uchun kerak.
KURS_BOT_TOKEN=
# bot/.env dagi bilan BIR XIL (uzun tasodifiy qiymat, kamida 24 belgi)
BOT_SECRET=

# Brauzerdan ruxsat etilgan originlar (vergul bilan). Bo'sh = faqat bir xil origin
CORS_ORIGINS=https://panel.todayeducationcentre.uz

# Ixtiyoriy: bir IP dan 15 daqiqada login urinishlari soni (default 10)
# LOGIN_MAX_ATTEMPTS=10
